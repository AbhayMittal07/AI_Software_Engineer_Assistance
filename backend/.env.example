# ------------------------------------------------------------------
# AI Software Engineering Assistant - backend configuration
# Copy to .env and fill in the values.
# ------------------------------------------------------------------

ENVIRONMENT="development"
DEBUG="true"
LOG_LEVEL="INFO"
LOG_JSON="false"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ---------------------------- Database ----------------------------
# MySQL 8 (production / docker compose)
DATABASE_URL="mysql+aiomysql://ai_swe:ai_swe_password@localhost:3306/ai_swe_assistant"
# Zero-dependency local alternative:
# DATABASE_URL="sqlite+aiosqlite:///./data/app.db"
DB_ECHO="false"

# ---------------------------- Security ----------------------------
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET="replace-with-a-64-char-random-hex-string"
ACCESS_TOKEN_EXPIRE_MINUTES="60"
REFRESH_TOKEN_EXPIRE_DAYS="7"
BCRYPT_ROUNDS="12"

# Bootstrap accounts created on first start
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@12345"
DEMO_EMAIL="demo@example.com"
DEMO_PASSWORD="Demo@12345"

# ------------------------------ Redis -----------------------------
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS="300"
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS="200"
RATE_LIMIT_WINDOW_SECONDS="60"
AUTH_RATE_LIMIT_REQUESTS="10"
AUTH_RATE_LIMIT_WINDOW_SECONDS="60"

# ------------------------------- AI -------------------------------
# Get a key at https://aistudio.google.com/apikey
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-3.6-flash"
GEMINI_REASONING_MODEL="gemini-3.6-flash"
GEMINI_EMBED_MODEL="gemini-embedding-001"
AI_MAX_OUTPUT_TOKENS="8192"
AI_REQUEST_TIMEOUT="240"

# --------------------------- Vector store -------------------------
CHROMA_PATH="./data/chroma"
RAG_TOP_K="6"
RAG_CHUNK_SIZE="1600"
RAG_CHUNK_OVERLAP="200"
RAG_MAX_CHUNKS_PER_REPO="400"

# ----------------------------- Storage ----------------------------
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="100"
MAX_FILES_PER_REPO="4000"
